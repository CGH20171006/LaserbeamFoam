FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Interface tracking method: isoAdvector or MULES
interfaceTrackingScheme isoAdvector;

phases          (metal gas);

// phase properties for the metal and gas phases
metal
{
    transportModel      Newtonian;
    nu                  8e-07;
    rho                 4420;
    Tsolidus            1878;
    Tliquidus           1923;
    LatentHeat          9.83e5;
    beta                6.97e-5;
    poly_kappa          (2.125 0.01625 0 0 0 0 0 0);
    poly_cp             (639.8 0.1006 0 0 0 0 0 0);
    elec_resistivity    1.0e-6; 
}

gas
{
    transportModel      Newtonian;
    nu                  1.48e-05;
    rho                 1;
    Tsolidus            1.0;
    Tliquidus           10.0;
    LatentHeat          1;
    beta                4.0e-5;
    poly_kappa          (0.04 0.0 0 0 0 0 0 0);
    poly_cp             (520 0.0 0 0 0 0 0 0);
}

// phase change properties
sigma                  1.2935825769851585;
Marangoni_Constant     -2.540035439968193e-05;
p0		                101000.0;
Tvap                    3315.0;
Mm                      4.46e-2;
LatentHeatVap           9.83e6;
recoilCoeff            1.0;
damper                 0.5;
emS                     0.4;
emL                     0.1;
TRef                    TRef [0 0 0 1 0 0 0]   300;


